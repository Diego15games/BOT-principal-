import {
SlashCommandBuilder,
PermissionFlagsBits,
EmbedBuilder
} from 'discord.js';

import {
removeMoney,
getMoney
} from '../../systems/economia.js';

export default {
data: new SlashCommandBuilder()
.setName('deletgrana')
.setDescription('Retirar dinheiro de um jogador')
.addUserOption(option =>
option
.setName('usuario')
.setDescription('Jogador')
.setRequired(true)
)
.addIntegerOption(option =>
option
.setName('valor')
.setDescription('Valor a retirar')
.setRequired(true)
)
.setDefaultMemberPermissions(
PermissionFlagsBits.Administrator
),

cooldown: 3,

async execute(interaction) {

const usuario =
interaction.options.getUser(
'usuario'
);

const valor =
interaction.options.getInteger(
'valor'
);

if (valor <= 0) {

return interaction.reply({
content:
'❌ Valor inválido.',
ephemeral: true
});

}

const saldo =
await getMoney(
usuario.id
);

if (saldo <= 0) {

return interaction.reply({
content:
'❌ Este jogador não possui dinheiro.',
ephemeral: true
});

}

await removeMoney(
usuario.id,
valor
);

const novoSaldo =
await getMoney(
usuario.id
);

try {

await usuario.send({
embeds: [
new EmbedBuilder()
.setColor(0xed4245)
.setTitle(
'💸 Dinheiro Removido'
)
.setDescription(
`A staff removeu **R$ ${valor.toLocaleString('pt-BR')}** da sua conta.\n\nSeu novo saldo é **R$ ${novoSaldo.toLocaleString('pt-BR')}**.`
)
]
});

} catch {}

return interaction.reply({
embeds: [
new EmbedBuilder()
.setColor(0xed4245)
.setTitle(
'💸 Dinheiro Removido'
)
.setDescription(
`✅ Foram removidos **R$ ${valor.toLocaleString('pt-BR')}** de ${usuario}.\n\nNovo saldo: **R$ ${novoSaldo.toLocaleString('pt-BR')}**`
)
],
ephemeral: true
});

}
};
